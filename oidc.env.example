# OIDC-провайдери AI_BPMS (F4-14). Скопіюйте у oidc.env поруч із docker-compose.prod.yml — його читає сервіс api.
# Ключ провайдера (тут kit, entra) — латиниця в нижньому регістрі, цифри, дефіс; він же в redirect URI:
#   https://<OPENBP_PUBLIC_URL>/signin-oidc/<key>
# Детально, зокрема як зареєструвати клієнта в Keycloak і Entra ID: docs/admin/oidc.md.

# ---------- Keycloak «Кіт 2» (realm astarta) ----------
OpenBp__Oidc__Providers__kit__DisplayName=Кіт 2
OpenBp__Oidc__Providers__kit__Authority=https://sso.example.com/realms/astarta
OpenBp__Oidc__Providers__kit__ClientId=openbp
OpenBp__Oidc__Providers__kit__ClientSecret=
OpenBp__Oidc__Providers__kit__RoleClaim=realm_access.roles,resource_access.openbp.roles
OpenBp__Oidc__Providers__kit__RoleMap__admin__0=openbp-admin
OpenBp__Oidc__Providers__kit__RoleMap__editor__0=openbp-editor
OpenBp__Oidc__Providers__kit__AutoProvision=true
OpenBp__Oidc__Providers__kit__AllowedEmailDomains__0=astarta.ua
# Access token веб-клієнта Кіта (вбудований <openbp-canvas>) приймається як Bearer, якщо його azp/aud тут:
OpenBp__Oidc__Providers__kit__BearerAudiences__0=openbp
OpenBp__Oidc__Providers__kit__BearerAudiences__1=KitWeb

# ---------- Microsoft Entra ID (один тенант) ----------
# OpenBp__Oidc__Providers__entra__DisplayName=Microsoft
# OpenBp__Oidc__Providers__entra__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
# OpenBp__Oidc__Providers__entra__ClientId=<application-id>
# OpenBp__Oidc__Providers__entra__ClientSecret=
# OpenBp__Oidc__Providers__entra__RoleClaim=roles
# OpenBp__Oidc__Providers__entra__RoleMap__admin__0=OpenBP.Admin
# OpenBp__Oidc__Providers__entra__RoleMap__editor__0=OpenBP.Editor
# OpenBp__Oidc__Providers__entra__AutoProvision=true
# OpenBp__Oidc__Providers__entra__TrustEmail=true
# OpenBp__Oidc__Providers__entra__AllowedEmailDomains__0=astarta.ua
