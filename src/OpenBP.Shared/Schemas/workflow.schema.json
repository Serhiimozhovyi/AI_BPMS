{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbp.dev/schemas/workflow-format/1.json",
  "title": "OpenBP workflow (formatVersion 1)",
  "description": "Формат сценарію OpenBP. Джерело правди — docs/workflow-format.md. Невідомі поля дозволені й зберігаються.",
  "type": "object",
  "required": ["formatVersion", "name", "settings", "nodes", "connections", "pinData"],
  "properties": {
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "settings": { "$ref": "#/$defs/settings" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "pinData": {
      "type": "object",
      "description": "id вузла → items для ручного тестового запуску.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/item" }
      }
    },
    "business": { "$ref": "#/$defs/business" },
    "stages": {
      "type": "array",
      "description": "Етапи бізнес-процесу над графом (ADR-004, docs/workflow-format.md §«Етапи»). Необов'язкові; без них рушій працює як раніше. Валідатор перевіряє унікальність id, посилання на вузли й етапи, зв'язність етапу.",
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "required": ["timezone", "executionTimeoutSec", "errorWorkflowId", "saveSuccessfulData"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "executionTimeoutSec": { "type": "integer", "minimum": 0 },
        "errorWorkflowId": { "type": ["string", "null"] },
        "saveSuccessfulData": { "type": "boolean" },
        "concurrency": {
          "type": "object",
          "description": "Ліміт одночасних виконань сценарію (ручні тестові запуски не враховуються).",
          "required": ["max"],
          "properties": {
            "max": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "onLimit": { "enum": ["queue", "drop"] }
          }
        },
        "throttle": {
          "type": "object",
          "description": "Ліміт кількості запусків у фіксованому вікні periodSec (ручні тестові запуски не враховуються).",
          "required": ["limit", "periodSec"],
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "periodSec": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "onLimit": { "enum": ["queue", "drop"] }
          }
        },
        "disableAfterErrors": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "correlation": {
          "type": "object",
          "description": "Ключ кореляції виконань: skipIfActive — не запускати нове, якщо є активне з тим самим ключем.",
          "properties": {
            "skipIfActive": { "type": "boolean" }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "name", "type", "typeVersion", "position", "parameters"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)+$",
          "description": "<пакет>.<вузол>, напр. core.if, mcp.tool, ai.llm"
        },
        "typeVersion": { "type": "integer", "minimum": 1 },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "parameters": { "type": "object" },
        "timeoutSec": { "type": "integer", "minimum": 1 },
        "retry": { "$ref": "#/$defs/retry" },
        "continueOnFail": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "notes": { "type": "string" },
        "business": { "$ref": "#/$defs/nodeBusiness" }
      }
    },
    "retry": {
      "type": "object",
      "required": ["maxTries", "waitMs"],
      "properties": {
        "maxTries": { "type": "integer", "minimum": 1 },
        "waitMs": { "type": "integer", "minimum": 0 }
      }
    },
    "connection": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "object",
          "required": ["node", "output"],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "output": { "type": "integer", "minimum": 0 }
          }
        },
        "to": {
          "type": "object",
          "required": ["node", "input"],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "input": { "type": "integer", "minimum": 0 }
          }
        },
        "business": {
          "type": "object",
          "description": "Бізнес-вигляд: підпис стрілки; без нього — назва виходу.",
          "properties": {
            "label": { "type": "string" }
          }
        }
      }
    },
    "business": {
      "type": "object",
      "description": "Бізнес-розмітка для бізнес-вигляду (docs/business-view.md): доріжки учасників і кроки людей у зовнішніх системах. Необов'язкова; рушій ігнорує. Валідатор перевіряє унікальність id і посилання lane/links[].node.",
      "properties": {
        "lanes": {
          "type": "array",
          "description": "Доріжки (хто виконує) у порядку показу. Немає — доріжки за типом вузла.",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "description": "Підпис під назвою, напр. «люди у веб-формах»." }
            }
          }
        },
        "steps": {
          "type": "array",
          "description": "Дії людей у зовнішніх системах, яких немає в графі; кожен крок має хоча б один зв'язок із вузлом.",
          "items": {
            "type": "object",
            "required": ["id", "title", "lane", "links"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "subtitle": { "type": "string" },
              "lane": { "type": "string", "minLength": 1, "description": "id доріжки з business.lanes." },
              "links": {
                "type": "array",
                "description": "Стрілки між кроком і вузлами; потрібна хоча б одна.",
                "items": {
                  "type": "object",
                  "required": ["node", "direction"],
                  "properties": {
                    "node": { "type": "string", "minLength": 1, "description": "id вузла сценарію." },
                    "direction": {
                      "enum": ["in", "out"],
                      "description": "in — вузол читає результат кроку (пунктирна стрілка крок → вузол); out — вузол ставить людині задачу (суцільна стрілка вузол → крок)."
                    },
                    "label": { "type": "string", "description": "Підпис стрілки, напр. «читає статус»." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "nodeBusiness": {
      "type": "object",
      "description": "Як вузол показується в бізнес-вигляді. Без title — name вузла; без lane — доріжка за типом вузла.",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "lane": { "type": "string", "minLength": 1, "description": "id доріжки з business.lanes." },
        "hidden": { "type": "boolean", "description": "true — не показувати вузол; false — показувати технічний вузол (core.set, core.code, core.merge), який інакше згорнувся б." }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "name", "nodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "description": "id вузлів етапу; кожен вузол — щонайбільше в одному етапі.",
          "items": { "type": "string", "minLength": 1 }
        },
        "owner": {
          "type": "object",
          "description": "Хто виконує етап: доріжка бізнес-вигляду (id з business.lanes), роль або вираз.",
          "properties": {
            "lane": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "expression": { "type": "string", "minLength": 1 }
          }
        },
        "due": {
          "type": "object",
          "description": "Строк від входу в етап: amount + unit або вираз дати until.",
          "properties": {
            "amount": { "type": "integer", "minimum": 1 },
            "unit": { "enum": ["minutes", "hours", "days", "businessDays"], "description": "businessDays — пн–пт за settings.timezone." },
            "until": { "type": "string", "minLength": 1, "description": "Вираз, що дає дату-час завершення." }
          }
        },
        "transitions": {
          "type": "array",
          "description": "Правила на переходах з етапу; без to — на всіх виходах.",
          "items": {
            "type": "object",
            "required": ["rules"],
            "properties": {
              "to": { "type": "string", "minLength": 1, "description": "id етапу-призначення." },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "condition"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "condition": { "type": "string", "minLength": 1, "description": "Вираз над items переходу; true — правило виконане." },
                    "mode": { "enum": ["block", "warn"], "description": "block — перехід чекає виправлення або відхилення з причиною; warn (типово) — проходить, порушення фіксується." },
                    "message": { "type": "string", "description": "Повідомлення для людини, коли правило не виконане." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["json"],
      "properties": {
        "json": { "type": "object" },
        "binary": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/binaryRef" }
        }
      }
    },
    "binaryRef": {
      "type": "object",
      "required": ["id", "mimeType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "fileName": { "type": "string" },
        "fileExtension": { "type": "string" },
        "fileSize": { "type": "integer", "minimum": 0 },
        "storage": { "type": "string", "enum": ["local", "s3"] },
        "directory": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
