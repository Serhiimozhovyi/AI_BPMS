{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mcp.poll",
  "type": "object",
  "required": [
    "serverId",
    "toolName",
    "cron",
    "keyField"
  ],
  "additionalProperties": false,
  "properties": {
    "serverId": {
      "type": "string",
      "minLength": 1
    },
    "toolName": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "object"
    },
    "itemsPath": {
      "type": "string",
      "minLength": 1
    },
    "cron": {
      "type": "string",
      "minLength": 1
    },
    "keyField": {
      "type": "string",
      "minLength": 1
    },
    "correlationKey": {
      "title": "Ключ кореляції",
      "description": "Вираз над новим записом, напр. {{ $json.Id }}: кожен новий запис запускає окреме виконання з цим ключем; з settings.correlation.skipIfActive запис з ключем активного виконання пропускається.",
      "type": "string",
      "maxLength": 500
    }
  }
}
