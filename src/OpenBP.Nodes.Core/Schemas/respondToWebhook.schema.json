{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "core.respondToWebhook",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "statusCode": {
      "title": "HTTP-статус",
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "default": 200
    },
    "headers": {
      "title": "Заголовки",
      "description": "Ім'я → значення, напр. { \"Content-Type\": \"text/csv\" }.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "body": {
      "title": "Тіло",
      "description": "Значення або вираз: рядок — текст, інше — JSON. Порожньо — json першого item'а."
    },
    "binaryKey": {
      "title": "Файл з item'а",
      "description": "Ключ у binary першого item'а, напр. data: тілом стане файл з його типом. Замість «Тіло».",
      "type": "string",
      "minLength": 1
    }
  }
}
