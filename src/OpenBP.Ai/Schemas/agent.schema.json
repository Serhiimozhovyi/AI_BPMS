{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai.agent",
  "type": "object",
  "required": [
    "provider",
    "model",
    "credentialId",
    "prompt"
  ],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "anthropic",
        "openai",
        "gemini",
        "openai-compatible",
        "ollama"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "credentialId": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "serverId",
          "toolName"
        ],
        "additionalProperties": false,
        "properties": {
          "serverId": {
            "type": "string",
            "minLength": 1
          },
          "toolName": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "table",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "maxMessages": {
          "type": "integer",
          "minimum": 2,
          "maximum": 200
        }
      }
    },
    "maxIterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 1
    },
    "tokenBudget": {
      "type": "integer",
      "minimum": 1
    },
    "outputSchema": {
      "type": "object"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    }
  }
}
