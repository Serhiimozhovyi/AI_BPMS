{
  "formatVersion": 1,
  "name": "Бот психологічної підтримки",
  "settings": {
    "timezone": "Europe/Kyiv",
    "executionTimeoutSec": 60,
    "errorWorkflowId": null,
    "saveSuccessfulData": false
  },
  "nodes": [
    {
      "id": "n_webhook",
      "name": "Telegram",
      "type": "core.webhook",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "parameters": {
        "method": "POST",
        "path": "psy-bot",
        "auth": {
          "type": "header",
          "credentialId": "cred_psy_bot_webhook",
          "headerName": "X-Telegram-Bot-Api-Secret-Token"
        }
      },
      "notes": "setWebhook з secret_token; credential cred_psy_bot_webhook — { token } з тим самим секретом."
    },
    {
      "id": "n_parse",
      "name": "Розбір",
      "type": "core.code",
      "typeVersion": 1,
      "position": [
        240,
        400
      ],
      "parameters": {
        "code": "// Telegram update → поля для tools бота (docs/psy-support.md §6). Інші види оновлень відкидаються.\nconst u = $json.body || {};\nconst cb = u.callback_query || null;\nconst m = cb ? cb.message : u.message;\nif (!m) return null;\nconst from = cb ? cb.from : (m.from || {});\nconst data = cb ? String(cb.data || '') : String(m.text || '').trim();\nconst contact = !cb && m.contact\n  ? { user_id: m.contact.user_id === undefined ? null : m.contact.user_id, phone_number: String(m.contact.phone_number) }\n  : null;\nconst rules = [\n  ['menu', /^m:(psy|help|sos)$/],\n  ['materials', /^(m:mat$|mt:)/],\n  ['consult', /^(m:cons$|c:)/],\n  ['events', /^(m:ev$|e:)/],\n  ['bst', /^(m:bst$|b:)/],\n  ['cabinet', /^(\\/psy$|p:)/],\n];\nlet section = cb ? 'menu' : 'start';\nfor (const [name, re] of rules) {\n  if (re.test(data)) { section = name; break; }\n}\nreturn {\n  section,\n  telegram_id: from.id,\n  name: from.first_name || null,\n  chat_id: m.chat.id,\n  message_id: cb ? m.message_id : null,\n  callback_id: cb ? cb.id : null,\n  data,\n  contact,\n};"
      }
    },
    {
      "id": "n_switch",
      "name": "Розділ",
      "type": "core.switch",
      "typeVersion": 2,
      "position": [
        480,
        400
      ],
      "parameters": {
        "rules": [
          {
            "conditions": [
              {
                "left": "{{ $json.section }}",
                "operator": "equals",
                "right": "start"
              }
            ]
          },
          {
            "conditions": [
              {
                "left": "{{ $json.section }}",
                "operator": "equals",
                "right": "menu"
              }
            ]
          },
          {
            "conditions": [
              {
                "left": "{{ $json.section }}",
                "operator": "equals",
                "right": "materials"
              }
            ]
          },
          {
            "conditions": [
              {
                "left": "{{ $json.section }}",
                "operator": "equals",
                "right": "consult"
              }
            ]
          },
          {
            "conditions": [
              {
                "left": "{{ $json.section }}",
                "operator": "equals",
                "right": "events"
              }
            ]
          },
          {
            "conditions": [
              {
                "left": "{{ $json.section }}",
                "operator": "equals",
                "right": "bst"
              }
            ]
          },
          {
            "conditions": [
              {
                "left": "{{ $json.section }}",
                "operator": "equals",
                "right": "cabinet"
              }
            ]
          }
        ]
      },
      "notes": "Вихід 0 — fallback (невідомий розділ нікуди не йде), вихід i + 1 — правило i."
    },
    {
