        160
      ],
      "parameters": {
        "serverId": "srv_telegram",
        "toolName": "answer_callback_query",
        "arguments": "{{ $json.answer }}"
      }
    },
    {
      "id": "n_if_edit",
      "name": "Редагувати?",
      "type": "core.if",
      "typeVersion": 1,
      "position": [
        1300,
        340
      ],
      "parameters": {
        "conditions": [
          {
            "left": "{{ $json.edit }}",
            "operator": "isNotEmpty"
          }
        ]
      }
    },
    {
      "id": "n_edit",
      "name": "Змінити повідомлення",
      "type": "mcp.tool",
      "typeVersion": 1,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "serverId": "srv_telegram",
        "toolName": "edit_message_text",
        "arguments": "{{ $json.edit }}"
      },
      "continueOnFail": true,
      "notes": "Повторне натискання тієї самої кнопки Telegram відхиляє як «message is not modified» — це не помилка сценарію."
    },
    {
