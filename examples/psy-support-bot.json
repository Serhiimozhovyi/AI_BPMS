      "parameters": {
        "serverId": "srv_psy_support",
        "toolName": "bot_start",
        "arguments": {
          "telegram_id": "{{ $json.telegram_id }}",
          "name": "{{ $json.name }}",
          "contact": "{{ $json.contact }}"
        }
      }
    },
    {
