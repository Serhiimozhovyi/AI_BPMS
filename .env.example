# Скопіюйте у .env і змініть значення (або scripts/gen-env.sh — створить .env з випадковими секретами).
# .env не комітиться. Той самий файл читають docker-compose.yml (розробка) і docker-compose.prod.yml (продакшн).

# ---------- База даних ----------
# PostgreSQL. У продакшні (docker-compose.prod.yml) пароль обов'язковий і має бути випадковим.
POSTGRES_DB=openbp
POSTGRES_USER=openbp
POSTGRES_PASSWORD=openbp
# Порт БД на хості — лише для docker-compose.yml (розробка); продакшн-БД назовні не відкривається.
POSTGRES_PORT=5432

# Рядок підключення для OpenBP.Api / OpenBP.Worker / міграцій при запуску з dotnet (розробка).
# docker-compose.prod.yml складає його сам із POSTGRES_* вище.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=openbp;Username=openbp;Password=openbp

# ---------- Секрети і перший вхід ----------
# Ключ шифрування credentials: 32 байти у base64 (AES-256-GCM, docs/architecture.md §8).
# Згенерувати: openssl rand -base64 32. Бекапте його окремо від БД: без нього credentials не розшифруються.
OPENBP_ENCRYPTION_KEY=

# Перший адміністратор: створюється при старті OpenBP.Api, якщо таблиця users порожня (docs/architecture.md §10.6).
OPENBP_ADMIN_EMAIL=
OPENBP_ADMIN_PASSWORD=

# ---------- Адреса і порт (продакшн) ----------
# Порт веб-інтерфейсу на хості (docker-compose.prod.yml відкриває лише його).
OPENBP_HTTP_PORT=8080
# Публічна адреса AI_BPMS, як її бачать браузер і зовнішні сервіси (без / в кінці): redirect URI OAuth2
# (https://<адреса>/api/v1/oauth2/callback), OIDC-входу (https://<адреса>/signin-oidc/<key>) і адреси webhook-ів.
# Порожньо — береться хост запиту.
OPENBP_PUBLIC_URL=
# Сторінки інших застосунків, що вбудовують редактор <openbp-canvas> (docs/embedding.md): origin-и через кому,
# напр. https://kit.example.com. Порожньо — крос-доменні запити з браузера заборонені.
# OPENBP_CORS_ORIGINS=
# Вхід паролем (F4-14): false — лише аварійний адміністратор OPENBP_ADMIN_EMAIL (сторінка /login?password),
# решта входить через OIDC-провайдерів з oidc.env (зразок — oidc.env.example, docs/admin/oidc.md). Типово true.
# OPENBP_PASSWORD_LOGIN=true
# Тег образів docker-compose.prod.yml (openbp/api:<тег> тощо).
# OPENBP_VERSION=local
# Часовий пояс контейнерів (розклади очищення історії і журнали).
# TZ=Europe/Kyiv

# ---------- Виконання ----------
# Папка файлового сховища OpenBP.Worker (вкладення, файли з MCP-tools; docs/architecture.md §6).
# Без неї вузли, що зберігають файли, завершуються помилкою. У Docker — том /data/files.
Storage__LocalPath=./data/files
# S3-сумісне сховище файлів (F6-18, docs/admin/README.md §10). Задано бакет — воркер пише нові файли в S3 і
# створює бакет, якщо його немає; файли з Storage__LocalPath лишаються доступними на читання. Ключі не задано —
# стандартний ланцюжок AWS SDK (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, роль інстансу).
# Розробка: Storage__S3__Endpoint, Storage__S3__Bucket, Storage__S3__AccessKey, Storage__S3__SecretKey.
# docker-compose.prod.yml (MinIO з профілем s3 — OPENBP_S3_ENDPOINT=http://minio:9000):
# OPENBP_S3_ENDPOINT=
# OPENBP_S3_BUCKET=openbp-files
# OPENBP_S3_REGION=us-east-1
# OPENBP_S3_ACCESS_KEY=openbp
# OPENBP_S3_SECRET_KEY=
# OPENBP_MINIO_IMAGE=bitnamilegacy/minio:2025.7.23

# Трейси OpenTelemetry з воркера (F6-18): адреса OTLP-колектора, напр. http://otel-collector:4317. Порожньо — вимкнено.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=openbp-worker

# Межа таймауту виконання сценарію, с (OpenBP.Api і OpenBP.Worker; docs/workflow-format.md). Типово 3600.
# OPENBP_MAX_EXECUTION_TIMEOUT_SEC=3600

# Часовий пояс нового сценарію, якщо в тілі POST/PUT немає settings.timezone (OpenBP.Api). Типово Europe/Kyiv.
# OPENBP_DEFAULT_TIMEZONE=Europe/Kyiv

# Таблиці даних (F6-11, OpenBP.Api і OpenBP.Worker): найбільше рядків у таблиці й розмір рядка в байтах.
# OPENBP_DATA_TABLE_MAX_ROWS=100000
# OPENBP_DATA_TABLE_MAX_ROW_BYTES=65536

# Очищення історії виконань в OpenBP.Api (docs/architecture.md §10.4): завершені виконання, старші за N днів
# (0 — не видаляти), видаляються за розкладом (Quartz cron або 5 полів crontab, час сервера). Типово 30 днів о 03:00.
# OPENBP_EXECUTION_RETENTION_DAYS=30
# OPENBP_EXECUTION_RETENTION_CRON=0 0 3 * * ?
# Журнал аудиту (F6-15): записи, старші за N днів, видаляє той самий job (0 — не видаляти). Типово 365.
# OPENBP_AUDIT_RETENTION_DAYS=365

# Сповіщення адміністратору (F6-07, OpenBP.Api): як часто перевіряти воркери й бекап і розсилати події з черги, с
# (0 — не розсилати). Канали налаштовує admin у «Налаштуваннях».
# OPENBP_NOTIFICATIONS_INTERVAL_SEC=30
# GET /metrics (Prometheus) в Api і Worker без входу. Типово false — лише з API-ключем admin'а.
# OPENBP_METRICS_ALLOW_ANONYMOUS=false

# ---------- Бекапи (продакшн) ----------
# Сервіс backup у docker-compose.prod.yml: pg_dump -Fc за розкладом (5 полів crontab, часовий пояс TZ) у теку
# на хості; файли, старші за KEEP_DAYS днів, видаляються (0 — не видаляти). Разово: scripts/backup.sh,
# відновлення: scripts/restore.sh <файл>. OPENBP_ENCRYPTION_KEY у дамп не потрапляє — бекапте його окремо.
# OPENBP_BACKUP_CRON=0 2 * * *
# OPENBP_BACKUP_KEEP_DAYS=14
# OPENBP_BACKUP_DIR=./backups
# Власник файлів бекапу на хості (scripts/gen-env.sh підставляє поточного користувача; типово root).
OPENBP_BACKUP_UID=0
OPENBP_BACKUP_GID=0

# ---------- Журнали і стан ----------
# json — JSON-консоль зі scope виконання (README, «Стан сервісів і журнали»); у docker-compose.prod.yml типово json.
# OPENBP_LOG_FORMAT=json
# Порт /health/live і /health/ready воркера.
# OPENBP_WORKER_HEALTH_PORT=8089
