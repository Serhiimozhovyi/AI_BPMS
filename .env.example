# Скопіюйте у .env і змініть значення. .env не комітиться.

# PostgreSQL для docker-compose.yml (лише для локальної розробки)
POSTGRES_DB=openbp
POSTGRES_USER=openbp
POSTGRES_PASSWORD=openbp
POSTGRES_PORT=5432

# Рядок підключення для OpenBP.Api / OpenBP.Worker / міграцій
ConnectionStrings__Default=Host=localhost;Port=5432;Database=openbp;Username=openbp;Password=openbp

# Ключ шифрування credentials: 32 байти у base64 (AES-256-GCM, docs/architecture.md §8).
# Згенерувати: openssl rand -base64 32
OPENBP_ENCRYPTION_KEY=

# Перший адміністратор: створюється при старті OpenBP.Api, якщо таблиця users порожня (docs/architecture.md §10.6).
OPENBP_ADMIN_EMAIL=
OPENBP_ADMIN_PASSWORD=

# Папка файлового сховища OpenBP.Worker (вкладення, файли з MCP-tools; docs/architecture.md §6).
# Без неї вузли, що зберігають файли, завершуються помилкою.
Storage__LocalPath=./data/files
