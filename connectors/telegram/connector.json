{
  "$schema": "../../tools/connector-template/schemas/connector.schema.json",
  "id": "telegram",
  "name": "Telegram Bot API",
  "description": "Повідомлення, кнопки, документи й оновлення бота Telegram (send_message, get_updates…).",
  "icon": "✈️",
  "transport": "stdio",
  "stdio": {
    "command": "dotnet",
    "arguments": [
      "/opt/openbp/connectors/telegram/OpenBP.Connectors.Telegram.dll"
    ]
  },
  "http": {
    "url": "http://telegram:8080/mcp"
  },
  "credential": {
    "env": [
      {
        "name": "TELEGRAM_BOT_TOKEN",
        "title": "Токен бота від @BotFather",
        "required": true,
        "secret": true
      }
    ],
    "headers": []
  },
  "triggers": [
    {
      "id": "new_update",
      "title": "Нове повідомлення Telegram",
      "description": "Вхідні повідомлення й натискання кнопок бота; перевірка щохвилини (після F6-22 — миттєво, mcp.subscribe).",
      "node": {
        "type": "mcp.poll",
        "parameters": {
          "toolName": "get_updates",
          "arguments": {},
          "itemsPath": "result",
          "keyField": "update_id",
          "cron": "*/1 * * * *"
        }
      }
    }
  ]
}
