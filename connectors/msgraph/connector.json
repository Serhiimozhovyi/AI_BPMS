{
  "$schema": "../../tools/connector-template/schemas/connector.schema.json",
  "id": "msgraph",
  "name": "Microsoft Graph: пошта й Excel",
  "description": "Листи, вкладення й надсилання пошти, рядки книг Excel у SharePoint/OneDrive через Microsoft Graph (client credentials).",
  "icon": "✉️",
  "transport": "stdio",
  "stdio": {
    "command": "dotnet",
    "arguments": [
      "/opt/openbp/connectors/msgraph/OpenBP.Connectors.MsGraph.dll"
    ]
  },
  "http": {
    "url": "http://msgraph:8080/mcp"
  },
  "credential": {
    "env": [
      {
        "name": "TENANT_ID",
        "title": "Tenant ID застосунку Entra",
        "required": true,
        "secret": false
      },
      {
        "name": "CLIENT_ID",
        "title": "Client ID застосунку",
        "required": true,
        "secret": false
      },
      {
        "name": "CLIENT_SECRET",
        "title": "Client secret застосунку",
        "required": true,
        "secret": true
      }
    ],
    "headers": []
  },
  "actions": [
    {
      "name": "append_row",
      "title": "Додати рядок (Excel)",
      "description": "Додає рядок у таблицю книги Excel."
    },
    {
      "name": "append_rows",
      "title": "Додати кілька рядків (Excel)",
      "description": "Додає список рядків у таблицю книги Excel."
    },
    {
      "name": "get_attachment",
      "title": "Отримати вкладення",
      "description": "Вміст вкладення листа."
    },
    {
      "name": "get_message",
      "title": "Отримати лист",
      "description": "Лист за ідентифікатором."
    },
    {
      "name": "list_attachments",
      "title": "Список вкладень листа"
    },
    {
      "name": "list_messages",
      "title": "Список листів",
      "description": "Листи поштової скриньки."
    },
    {
      "name": "read_sheets",
      "title": "Прочитати аркуші (Excel)",
      "description": "Рядки аркушів книги Excel."
    },
    {
      "name": "send_mail",
      "title": "Надіслати лист",
      "description": "Лист від імені поштової скриньки, за потреби з вкладеннями."
    },
    {
      "name": "update_row",
      "title": "Змінити рядок (Excel)"
    },
    {
      "name": "upsert_row",
      "title": "Додати або змінити рядок (Excel)"
    }
  ],
  "triggers": [
    {
      "id": "new_mail",
      "title": "Новий лист",
      "description": "Нові листи у «Вхідних»: замініть {mailbox} у resourceUri адресою скриньки, напр. msgraph://mail/orders@contoso.com/inbox.",
      "node": {
        "type": "mcp.subscribe",
        "parameters": {
          "resourceUri": "msgraph://mail/{mailbox}/inbox",
          "itemsPath": "result",
          "keyField": "id"
        }
      }
    }
  ]
}
