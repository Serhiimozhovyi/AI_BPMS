{
  "$schema": "../../tools/connector-template/schemas/connector.schema.json",
  "id": "msgraph",
  "name": "Microsoft Graph: пошта й Excel",
  "description": "Листи, вкладення й надсилання пошти, рядки книг Excel у SharePoint/OneDrive через Microsoft Graph (client credentials).",
  "icon": "✉️",
  "transport": "stdio",
  "stdio": {
    "command": "dotnet",
    "arguments": [
      "/opt/openbp/connectors/msgraph/OpenBP.Connectors.MsGraph.dll"
    ]
  },
  "http": {
    "url": "http://msgraph:8080/mcp"
  },
  "credential": {
    "env": [
      {
        "name": "TENANT_ID",
        "title": "Tenant ID застосунку Entra",
        "required": true,
        "secret": false
      },
      {
        "name": "CLIENT_ID",
        "title": "Client ID застосунку",
        "required": true,
        "secret": false
      },
      {
        "name": "CLIENT_SECRET",
        "title": "Client secret застосунку",
        "required": true,
        "secret": true
      }
    ],
    "headers": []
  },
  "triggers": [
    {
      "id": "new_mail",
      "title": "Новий лист",
      "description": "Нові листи вхідних поточної скриньки (mailbox вкажіть у вузлі); перевірка щохвилини.",
      "node": {
        "type": "mcp.poll",
        "parameters": {
          "toolName": "list_messages",
          "arguments": {
            "mailbox": "",
            "folder": "inbox",
            "top": 50
          },
          "itemsPath": "result",
          "keyField": "id",
          "cron": "*/1 * * * *"
        }
      }
    }
  ]
}
