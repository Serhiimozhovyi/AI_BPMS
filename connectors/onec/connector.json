{
  "$schema": "../../tools/connector-template/schemas/connector.schema.json",
  "id": "onec",
  "name": "1С (OData)",
  "description": "Замовлення, звіт продажів і згенеровані з $metadata tools над OData 1С (standard.odata).",
  "icon": "🧾",
  "transport": "stdio",
  "stdio": {
    "command": "dotnet",
    "arguments": [
      "/opt/openbp/connectors/onec/OpenBP.Connectors.OneC.dll"
    ]
  },
  "http": {
    "url": "http://onec:8080/mcp"
  },
  "credential": {
    "type": "basic",
    "map": {
      "username": "ONEC_USERNAME",
      "password": "ONEC_PASSWORD"
    },
    "env": [
      {
        "name": "Connector__BaseUrl",
        "title": "Адреса OData, напр. http://srv/trade/odata/standard.odata/",
        "required": true,
        "secret": false
      },
      {
        "name": "ONEC_USERNAME",
        "title": "Користувач 1С",
        "required": true,
        "secret": false
      },
      {
        "name": "ONEC_PASSWORD",
        "title": "Пароль користувача 1С",
        "required": false,
        "secret": true
      }
    ],
    "headers": []
  },
  "settings": [
    {
      "name": "baseUrl",
      "title": "Адреса OData",
      "description": "Стандартний OData-інтерфейс бази 1С.",
      "placeholder": "http://srv/trade/odata/standard.odata/",
      "required": true,
      "env": "Connector__BaseUrl"
    }
  ],
  "actions": [
    {
      "name": "create_order",
      "title": "Створити замовлення клієнта"
    },
    {
      "name": "sales_report",
      "title": "Звіт про продажі"
    }
  ],
  "triggers": [
    {
      "id": "new_document",
      "title": "Новий документ 1С",
      "description": "Нові документи «Замовлення покупця»; назву tool'а (list_<набір>) звірте зі своїм Connector:Source.",
      "node": {
        "type": "mcp.poll",
        "parameters": {
          "toolName": "list_document_orders",
          "arguments": {},
          "itemsPath": "value",
          "keyField": "Ref_Key",
          "cron": "*/5 * * * *"
        }
      }
    }
  ]
}
