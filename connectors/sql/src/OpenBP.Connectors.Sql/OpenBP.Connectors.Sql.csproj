<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- MCP-сервер бази даних (Postgres, MySQL): stdio (за замовчуванням) або Streamable HTTP (аргумент http з адресою). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenBP.Connectors.Sql</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenBP.Connectors.Sql.Tests" />
  </ItemGroup>

</Project>
