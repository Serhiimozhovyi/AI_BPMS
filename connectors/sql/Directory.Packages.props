<Project>

  <!-- Ті самі версії, що в Directory.Packages.props репозиторію AI_BPMS (оновлюються разом, задача M-01). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="MCP">
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Бази даних">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- MySqlConnector — MIT (THIRD_PARTY_NOTICES.md). -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup Label="Тести">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
  </ItemGroup>

</Project>
