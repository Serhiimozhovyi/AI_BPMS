{
  "$schema": "../../tools/connector-template/schemas/connector.schema.json",
  "id": "kit-crm",
  "name": "Кіт CRM",
  "description": "Угоди, задачі, контрагенти, особи й нотатки Кіт CRM через OData; changes_since для mcp.poll, керівник із профілю.",
  "icon": "🐈",
  "transport": "stdio",
  "stdio": {
    "command": "dotnet",
    "arguments": [
      "/opt/openbp/connectors/kit-crm/OpenBP.Connectors.KitCrm.dll"
    ]
  },
  "http": {
    "url": "http://kit-crm:8080/mcp"
  },
  "credential": {
    "env": [
      {
        "name": "Connector__BaseUrl",
        "title": "Адреса OData Кіта, напр. https://crm-dev.example.ua/odata/",
        "required": true,
        "secret": false
      },
      {
        "name": "KIT_TOKEN_URL",
        "title": "Token endpoint Keycloak, напр. https://sso/realms/astarta/protocol/openid-connect/token",
        "required": true,
        "secret": false
      },
      {
        "name": "KIT_CLIENT_ID",
        "title": "Client ID сервісного клієнта Keycloak",
        "required": true,
        "secret": false
      },
      {
        "name": "KIT_CLIENT_SECRET",
        "title": "Client secret сервісного клієнта Keycloak",
        "required": true,
        "secret": true
      },
      {
        "name": "KIT_FRONT_PAGE_PATH",
        "title": "Заголовок FrontPagePath на запис (лише якщо роль користувача не CRM_user)",
        "required": false,
        "secret": false
      },
      {
        "name": "Connector__AuthorPersonId",
        "title": "Id особи (CrmPerson) сервісного користувача — автор нотаток",
        "required": false,
        "secret": false
      }
    ],
    "headers": []
  },
  "triggers": [
    {
      "id": "new_sale",
      "title": "Нова угода в Кіті",
      "description": "Нові угоди CRM: сигнал від kit://changes/sales, нові записи читає changes_since (createdOnly).",
      "node": {
        "type": "mcp.subscribe",
        "parameters": {
          "resourceUri": "kit://changes/sales",
          "toolName": "changes_since",
          "arguments": {
            "entity": "sales",
            "withinMinutes": 10,
            "createdOnly": true
          },
          "itemsPath": "result",
          "keyField": "id"
        }
      }
    },
    {
      "id": "changed_task",
      "title": "Нова чи змінена задача в Кіті",
      "description": "Кожна зміна задачі Кіта — окрема подія (kit://changes/tasks, ключ eventKey = id@час зміни).",
      "node": {
        "type": "mcp.subscribe",
        "parameters": {
          "resourceUri": "kit://changes/tasks",
          "itemsPath": "result",
          "keyField": "eventKey"
        }
      }
    }
  ]
}
