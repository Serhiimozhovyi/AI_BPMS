<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- MCP-сервер Google Sheets: stdio (за замовчуванням) або Streamable HTTP (аргумент http з адресою). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenBP.Connectors.GSheets</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenBP.Connectors.GSheets.Tests" />
  </ItemGroup>

</Project>
