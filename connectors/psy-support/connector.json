{
  "$schema": "../../tools/connector-template/schemas/connector.schema.json",
  "id": "psy-support",
  "name": "Психологічна підтримка",
  "description": "Бот і доменні tools застосунку психологічної підтримки з власною БД і адмінкою.",
  "icon": "💬",
  "transport": "stdio",
  "stdio": {
    "command": "dotnet",
    "arguments": [
      "/opt/openbp/connectors/psy-support/OpenBP.Connectors.PsySupport.dll"
    ]
  },
  "http": {
    "url": "http://psy-support:8090/mcp"
  },
  "credential": {
    "env": [
      {
        "name": "ConnectionStrings__PsySupport",
        "title": "Рядок підключення до бази psy_support",
        "required": true,
        "secret": true
      }
    ],
    "headers": [
      {
        "name": "Authorization",
        "title": "Bearer <PSY_MCP_TOKEN> (для http)",
        "required": true,
        "secret": true
      }
    ]
  },
  "actions": [
    {
      "name": "anonymize_old_records",
      "title": "Знеособити старі записи"
    },
    {
      "name": "book_bst",
      "title": "Записати на групову сесію"
    },
    {
      "name": "book_slot",
      "title": "Записатися на слот"
    },
    {
      "name": "bot_bst",
      "title": "Бот: групові сесії"
    },
    {
      "name": "bot_cabinet",
      "title": "Бот: кабінет психолога"
    },
    {
      "name": "bot_consult",
      "title": "Бот: консультації"
    },
    {
      "name": "bot_events",
      "title": "Бот: події"
    },
    {
      "name": "bot_materials",
      "title": "Бот: матеріали"
    },
    {
      "name": "bot_menu",
      "title": "Бот: меню, довідка, SOS"
    },
    {
      "name": "bot_start",
      "title": "Бот: початок і контакт"
    },
    {
      "name": "cancel_booking",
      "title": "Скасувати запис"
    },
    {
      "name": "cancel_bst",
      "title": "Скасувати запис на групову сесію"
    },
    {
      "name": "cancel_event_registration",
      "title": "Скасувати реєстрацію на подію"
    },
    {
      "name": "due_notifications",
      "title": "Сповіщення до відправлення"
    },
    {
      "name": "generate_slots",
      "title": "Згенерувати слоти"
    },
    {
      "name": "get_counters",
      "title": "Отримати лічильники"
    },
    {
      "name": "get_material",
      "title": "Прочитати матеріал"
    },
    {
      "name": "get_user",
      "title": "Отримати особу"
    },
    {
      "name": "join_waitlist",
      "title": "Стати в чергу очікування"
    },
    {
      "name": "leave_waitlist",
      "title": "Вийти з черги очікування"
    },
    {
      "name": "list_bookings",
      "title": "Список записів"
    },
    {
      "name": "list_bst_sessions",
      "title": "Список групових сесій"
    },
    {
      "name": "list_events",
      "title": "Список подій"
    },
    {
      "name": "list_materials",
      "title": "Список матеріалів"
    },
    {
      "name": "list_psychologists",
      "title": "Список психологів"
    },
    {
      "name": "list_slots",
      "title": "Список вільних слотів"
    },
    {
      "name": "mark_notifications_sent",
      "title": "Позначити сповіщення надісланими"
