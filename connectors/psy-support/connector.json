    {
      "name": "move_booking",
      "title": "Перенести запис"
    },
    {
      "name": "move_bst",
      "title": "Перенести запис на групову сесію"
    },
    {
      "name": "rate_event",
      "title": "Оцінити подію"
    },
    {
      "name": "register_event",
      "title": "Зареєструватися на подію"
    },
    {
      "name": "register_user",
      "title": "Зареєструвати особу"
    },
    {
      "name": "send_bst_notice",
      "title": "Надіслати нагадування про групову сесію"
