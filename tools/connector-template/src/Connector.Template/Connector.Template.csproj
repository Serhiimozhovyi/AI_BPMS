<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- MCP-сервер конектора: stdio (за замовчуванням) або Streamable HTTP (аргумент http з адресою). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Connector.Template</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Connector.Template.Tests" />
  </ItemGroup>

</Project>
