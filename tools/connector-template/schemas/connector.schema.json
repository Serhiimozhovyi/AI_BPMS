{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbp.dev/schemas/connector.schema.json",
  "title": "connector.json",
  "description": "Маніфест конектора для каталогу AI_BPMS (F6-16, docs/connectors.md §5.1): як встановити MCP-сервер одним кліком.",
  "type": "object",
  "required": ["id", "name", "description", "transport"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Стабільний ідентифікатор у каталозі; прив'язує встановлений конектор і залежності шаблонів сценаріїв.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": { "description": "Назва нового конектора за замовчуванням.", "type": "string", "minLength": 1 },
    "description": { "description": "Що вміє конектор (одне речення).", "type": "string" },
    "icon": { "description": "Іконка в каталозі: емодзі або коротка позначка.", "type": "string", "maxLength": 8 },
    "transport": { "description": "Транспорт за замовчуванням.", "enum": ["stdio", "http"] },
    "stdio": {
      "description": "Налаштування для stdio: AI_BPMS запускає процес сам.",
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "environment": { "description": "Несекретні змінні середовища.", "type": "object", "additionalProperties": { "type": "string" } },
        "workingDirectory": { "type": "string" }
      }
    },
    "http": {
      "description": "Налаштування для http: сервер працює окремо (напр. контейнер у тій самій мережі Compose).",
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "headers": { "description": "Несекретні заголовки.", "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "credential": {
      "description": "Облікові дані конектора (docs/connectors.md §5.2). Загальний тип (F3-93): type + map (поле → змінна середовища, stdio) і headerMap (поле → заголовок «Назва» або «Назва: префікс», http); обчислювані поля $accessToken, $authorization, $connectionString. Старий спосіб — env/headers для credential'а mcp.stdio/mcp.http.",
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "map": ["type"], "headerMap": ["type"] },
      "properties": {
        "type": {
          "description": "Загальний тип облікових даних (GET /api/v1/credentials/types).",
          "enum": ["telegram.bot", "apiKey", "bearer", "basic", "oauth2.clientCredentials", "oauth2", "database", "google.serviceAccount"]
        },
        "map": {
          "description": "Поле типу або $accessToken/$authorization/$connectionString → назва змінної середовища stdio-сервера.",
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "headerMap": {
          "description": "Поле типу → заголовок http-сервера: «Назва» або «Назва: префікс» (напр. «Authorization: Bearer»).",
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "env": { "type": "array", "items": { "$ref": "#/$defs/key" } },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/key" } }
      }
    },
    "settings": {
      "description": "Несекретні налаштування підключення (адреса сервісу, Id автора; F3-93): зберігаються в config конектора як змінна середовища (env, stdio) чи заголовок (header, http), не серед секретів.",
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    },
    "actions": {
      "description": "Дії (tools) конектора для палітри ще до підключення (F3-92): назви й описи; схему аргументів дає discovery підключення. Імена мають збігатися з tools/list сервера (перевіряє контрактний тест конектора).",
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "triggers": {
      "description": "Пресети тригерів конектора для палітри (docs/connectors.md §9.2): готовий вузол mcp.subscribe або mcp.poll без serverId.",
      "type": "array",
      "items": { "$ref": "#/$defs/trigger" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["name", "title"],
      "additionalProperties": false,
      "properties": {
        "name": { "description": "Ім'я tool'а в tools/list (toolName вузла).", "type": "string", "minLength": 1 },
        "title": { "description": "Назва дії для людини.", "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["id", "title", "node"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "node": {
          "type": "object",
          "required": ["type", "parameters"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["mcp.subscribe", "mcp.poll"] },
            "parameters": { "type": "object", "description": "Параметри вузла без serverId (підставляє палітра)." }
          }
        }
      }
    },
    "setting": {
      "type": "object",
      "required": ["name", "title"],
      "anyOf": [{ "required": ["env"] }, { "required": ["header"] }],
      "additionalProperties": false,
      "properties": {
        "name": { "description": "Ключ у settings запиту встановлення.", "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$" },
        "title": { "description": "Підпис поля.", "type": "string", "minLength": 1 },
        "description": { "description": "Підказка під полем.", "type": "string" },
        "placeholder": { "description": "Приклад значення.", "type": "string" },
        "required": { "type": "boolean" },
        "env": { "description": "Змінна середовища (stdio).", "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "header": { "description": "Заголовок (http).", "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" }
      }
    },
    "key": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" }
      }
    }
  }
}
