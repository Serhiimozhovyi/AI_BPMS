{
  "name": "Новини — дайджест",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "30 6,18 * * *" }] } },
      "id": "a1", "name": "Розклад", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 200] },
    { "parameters": { "url": "https://example.com/feed-a", "options": {} }, "id": "a2", "name": "Стрічка A",
      "type": "n8n-nodes-base.rssFeedRead", "typeVersion": 1.2, "position": [200, 100], "onError": "continueRegularOutput" },
    { "parameters": { "url": "https://example.com/feed-b", "options": {} }, "id": "a3", "name": "Стрічка B",
      "type": "n8n-nodes-base.rssFeedRead", "typeVersion": 1.2, "position": [200, 300], "onError": "continueRegularOutput" },
    { "parameters": { "numberInputs": 2 }, "id": "a4", "name": "Злити", "type": "n8n-nodes-base.merge", "typeVersion": 3.2, "position": [400, 200] },
    { "parameters": { "operation": "get", "dataTableId": { "__rl": true, "mode": "id", "value": "XyZ", "cachedResultName": "news_history" }, "returnAll": true },
      "id": "a5", "name": "Історія", "type": "n8n-nodes-base.dataTable", "typeVersion": 1, "position": [600, 200], "executeOnce": true, "alwaysOutputData": true },
    { "parameters": { "jsCode": "const hist = $('Історія').all().map(i => i.json);\nconst items = $('Злити').all().map(i => i.json);\nreturn [{ json: { candidates: items.filter(i => !hist.some(h => h.url === i.link)) } }];" },
      "id": "a6", "name": "Кандидати", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [800, 200] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
        "conditions": [{ "leftValue": "={{ $json.candidates.length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }], "combinator": "and" }, "options": {} },
      "id": "a7", "name": "Є кандидати?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1000, 200] },
    { "parameters": { "modelId": { "__rl": true, "mode": "id", "value": "qwen3:4b" },
        "messages": { "values": [{ "content": "=Новини: {{ JSON.stringify($json.candidates) }}" }] }, "options": { "system": "Ти редактор." } },
      "id": "a8", "name": "Модель пише пост", "type": "@n8n/n8n-nodes-langchain.ollama", "typeVersion": 1, "position": [1200, 100],
      "credentials": { "ollamaApi": { "id": "o1", "name": "Ollama local" } } },
    { "parameters": { "chatId": "-100", "text": "=Чернетка:\n{{ $json.text }}", "additionalFields": { "parse_mode": "HTML", "disable_web_page_preview": true } },
      "id": "a9", "name": "Надіслати чернетку", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1400, 100],
      "credentials": { "telegramApi": { "id": "t1", "name": "newsbot" } } },
    { "parameters": { "operation": "sendAndWait", "chatId": "-100", "message": "=Опублікувати {{ $('Кандидати').item.json.candidates.length }}?" },
      "id": "a10", "name": "Погодити?", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1600, 100],
      "credentials": { "telegramApi": { "id": "t1", "name": "newsbot" } } },
    { "parameters": { "conditions": { "conditions": [{ "leftValue": "={{ $json.data.approved }}", "rightValue": true,
        "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } },
      "id": "a11", "name": "Погоджено?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1800, 100] },
    { "parameters": { "method": "POST", "url": "http://localhost:7860/api", "options": {} }, "id": "a12", "name": "Картинка",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2000, 0], "onError": "continueErrorOutput" },
    { "parameters": { "chatId": "-200", "text": "={{ $('Модель пише пост').item.json.text }}", "additionalFields": {} },
      "id": "a13", "name": "Опублікувати", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [2200, 100],
      "credentials": { "telegramApi": { "id": "t1", "name": "newsbot" } } },
    { "parameters": { "dataTableId": { "__rl": true, "mode": "id", "value": "XyZ", "cachedResultName": "news_history" },
        "columns": { "mappingMode": "defineBelow", "value": { "status": "published", "post": "={{ $('Модель пише пост').item.json.text }}" },
          "schema": [{ "id": "status", "type": "string" }, { "id": "post", "type": "string" }, { "id": "url", "type": "string" }] } },
      "id": "a14", "name": "Зберегти", "type": "n8n-nodes-base.dataTable", "typeVersion": 1, "position": [2400, 100] },
    { "parameters": { "chatId": "-100", "text": "=Без поста", "additionalFields": {} }, "id": "a15", "name": "Без поста",
      "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1200, 300], "credentials": { "telegramApi": { "id": "t1", "name": "newsbot" } } },
    { "parameters": { "content": "Нотатка" }, "id": "a16", "name": "Sticky", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, 0] }
  ],
  "connections": {
    "Розклад": { "main": [[{ "node": "Стрічка A", "type": "main", "index": 0 }, { "node": "Стрічка B", "type": "main", "index": 0 }]] },
    "Стрічка A": { "main": [[{ "node": "Злити", "type": "main", "index": 0 }]] },
    "Стрічка B": { "main": [[{ "node": "Злити", "type": "main", "index": 1 }]] },
    "Злити": { "main": [[{ "node": "Історія", "type": "main", "index": 0 }]] },
    "Історія": { "main": [[{ "node": "Кандидати", "type": "main", "index": 0 }]] },
    "Кандидати": { "main": [[{ "node": "Є кандидати?", "type": "main", "index": 0 }]] },
    "Є кандидати?": { "main": [[{ "node": "Модель пише пост", "type": "main", "index": 0 }], [{ "node": "Без поста", "type": "main", "index": 0 }]] },
    "Модель пише пост": { "main": [[{ "node": "Надіслати чернетку", "type": "main", "index": 0 }]] },
    "Надіслати чернетку": { "main": [[{ "node": "Погодити?", "type": "main", "index": 0 }]] },
    "Погодити?": { "main": [[{ "node": "Погоджено?", "type": "main", "index": 0 }]] },
    "Погоджено?": { "main": [[{ "node": "Картинка", "type": "main", "index": 0 }], []] },
    "Картинка": { "main": [[{ "node": "Опублікувати", "type": "main", "index": 0 }], [{ "node": "Опублікувати", "type": "main", "index": 0 }]] },
    "Опублікувати": { "main": [[{ "node": "Зберегти", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1", "timezone": "Europe/Kyiv" }
}
