{
  "$comment": "Спільна таблиця кейсів умови «Показувати, якщо» (F11-06): її читають і Vitest (visible-if.spec.ts), і xUnit (VisibleIfTests). Змінюєте семантику — змінюйте тут, обидві реалізації мають пройти.",
  "cases": [
    { "name": "eq: рядок дорівнює", "rule": { "field": "a", "operator": "eq", "value": "так" }, "values": { "a": "так" }, "expected": true },
    { "name": "eq: рядок не дорівнює", "rule": { "field": "a", "operator": "eq", "value": "так" }, "values": { "a": "ні" }, "expected": false },
    { "name": "eq: регістр має значення", "rule": { "field": "a", "operator": "eq", "value": "Так" }, "values": { "a": "так" }, "expected": false },
    { "name": "eq: поле порожнє", "rule": { "field": "a", "operator": "eq", "value": "так" }, "values": {}, "expected": false },
    { "name": "eq: число з числом", "rule": { "field": "n", "operator": "eq", "value": 5 }, "values": { "n": 5 }, "expected": true },
    { "name": "eq: число з рядком-числом", "rule": { "field": "n", "operator": "eq", "value": 5 }, "values": { "n": "5.0" }, "expected": true },
    { "name": "eq: рядок-число з числом в умові", "rule": { "field": "n", "operator": "eq", "value": "10" }, "values": { "n": 10 }, "expected": true },
    { "name": "eq: так/ні з рядком true", "rule": { "field": "b", "operator": "eq", "value": "true" }, "values": { "b": true }, "expected": true },
    { "name": "eq: так/ні з булевим", "rule": { "field": "b", "operator": "eq", "value": true }, "values": { "b": false }, "expected": false },
    { "name": "eq: масив містить значення", "rule": { "field": "m", "operator": "eq", "value": "x" }, "values": { "m": ["y", "x"] }, "expected": true },
    { "name": "eq: масив без значення", "rule": { "field": "m", "operator": "eq", "value": "x" }, "values": { "m": ["y"] }, "expected": false },
    { "name": "ne: різні рядки", "rule": { "field": "a", "operator": "ne", "value": "так" }, "values": { "a": "ні" }, "expected": true },
    { "name": "ne: однакові рядки", "rule": { "field": "a", "operator": "ne", "value": "так" }, "values": { "a": "так" }, "expected": false },
    { "name": "ne: поле порожнє", "rule": { "field": "a", "operator": "ne", "value": "так" }, "values": { "a": "" }, "expected": true },
    { "name": "ne: числа", "rule": { "field": "n", "operator": "ne", "value": 3 }, "values": { "n": "3" }, "expected": false },
    { "name": "contains: підрядок без регістру", "rule": { "field": "a", "operator": "contains", "value": "КИЇВ" }, "values": { "a": "м. Київ, вул. Хрещатик" }, "expected": true },
    { "name": "contains: немає підрядка", "rule": { "field": "a", "operator": "contains", "value": "Львів" }, "values": { "a": "Київ" }, "expected": false },
    { "name": "contains: масив", "rule": { "field": "m", "operator": "contains", "value": "b" }, "values": { "m": ["a", "b"] }, "expected": true },
    { "name": "contains: масив чисел", "rule": { "field": "m", "operator": "contains", "value": "2" }, "values": { "m": [1, 2] }, "expected": true },
    { "name": "contains: поле порожнє", "rule": { "field": "a", "operator": "contains", "value": "x" }, "values": {}, "expected": false },
    { "name": "isEmpty: немає значення", "rule": { "field": "a", "operator": "isEmpty" }, "values": {}, "expected": true },
    { "name": "isEmpty: null", "rule": { "field": "a", "operator": "isEmpty" }, "values": { "a": null }, "expected": true },
    { "name": "isEmpty: порожній рядок", "rule": { "field": "a", "operator": "isEmpty" }, "values": { "a": "" }, "expected": true },
    { "name": "isEmpty: порожній масив", "rule": { "field": "a", "operator": "isEmpty" }, "values": { "a": [] }, "expected": true },
    { "name": "isEmpty: нуль — не порожньо", "rule": { "field": "a", "operator": "isEmpty" }, "values": { "a": 0 }, "expected": false },
    { "name": "isEmpty: false — не порожньо", "rule": { "field": "a", "operator": "isEmpty" }, "values": { "a": false }, "expected": false },
    { "name": "isNotEmpty: рядок", "rule": { "field": "a", "operator": "isNotEmpty" }, "values": { "a": "x" }, "expected": true },
    { "name": "isNotEmpty: порожній масив", "rule": { "field": "a", "operator": "isNotEmpty" }, "values": { "a": [] }, "expected": false },
    { "name": "gt: числа", "rule": { "field": "n", "operator": "gt", "value": 10 }, "values": { "n": 11 }, "expected": true },
    { "name": "gt: числа рівні", "rule": { "field": "n", "operator": "gt", "value": 10 }, "values": { "n": 10 }, "expected": false },
    { "name": "gt: число рядком — як число", "rule": { "field": "n", "operator": "gt", "value": "9" }, "values": { "n": "10" }, "expected": true },
    { "name": "gt: від'ємні й дробові", "rule": { "field": "n", "operator": "gt", "value": -1.5 }, "values": { "n": "-1" }, "expected": true },
    { "name": "gt: дати рядками", "rule": { "field": "d", "operator": "gt", "value": "2026-01-01" }, "values": { "d": "2026-03-15" }, "expected": true },
    { "name": "gt: поле порожнє", "rule": { "field": "n", "operator": "gt", "value": 0 }, "values": {}, "expected": false },
    { "name": "lt: числа", "rule": { "field": "n", "operator": "lt", "value": 10 }, "values": { "n": 2 }, "expected": true },
    { "name": "lt: 2 менше за 10, а не як рядки", "rule": { "field": "n", "operator": "lt", "value": "10" }, "values": { "n": "2" }, "expected": true },
    { "name": "lt: дати рядками", "rule": { "field": "d", "operator": "lt", "value": "2026-01-01" }, "values": { "d": "2026-03-15" }, "expected": false },
    { "name": "lt: без значення в умові", "rule": { "field": "n", "operator": "lt" }, "values": { "n": 1 }, "expected": false },
    { "name": "невідомий оператор — показувати", "rule": { "field": "a", "operator": "between", "value": 1 }, "values": { "a": 1 }, "expected": true }
  ]
}
