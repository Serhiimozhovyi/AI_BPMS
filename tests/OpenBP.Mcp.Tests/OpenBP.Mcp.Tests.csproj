<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- FakeServer — окремий проєкт у підтеці; його файли не компілюються в тестову збірку. -->
    <Compile Remove="FakeServer/**" />
    <None Remove="FakeServer/**" />
    <Content Remove="FakeServer/**" />
    <EmbeddedResource Remove="FakeServer/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenBP.Mcp/OpenBP.Mcp.csproj" />
    <ProjectReference Include="../../src/OpenBP.Engine.Testing/OpenBP.Engine.Testing.csproj" />
    <ProjectReference Include="FakeServer/OpenBP.Mcp.FakeServer.csproj" />
  </ItemGroup>

</Project>
